{
    "name": "talkasauras_bot",
    "version": "1.0.0",
    "description": "A Telegram bot powered by Ollama LLM with real-time messaging, job queuing, and database persistence",
    "type": "module",
    "main": "./dist/index.js",
    "keywords": [
        "telegram",
        "bot",
        "ollama",
        "llm",
        "ai",
        "messaging"
    ],
    "author": "IamDevTrivedi",
    "repository": {
        "type": "git",
        "url": "https://github.com/IamDevTrivedi/Talkasauras_Bot"
    },
    "scripts": {
        "build": "bun run typecheck && bun build ./src/index.ts --target=bun --outdir=dist --sourcemap=external",
        "dev": "NODE_ENV=development bun --watch src/index.ts",
        "start": "NODE_ENV=production bun dist/index.js",
        "clean:all": "bun scripts/clean-all.js",
        "install:all": "bun scripts/install-all.js",
        "reset:all": "bun scripts/reset-all.js",
        "check": "bun run lint:check && bun run format:check && bun run typecheck",
        "lint": "eslint . --fix",
        "lint:check": "eslint . --max-warnings=0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:migrate": "prisma migrate dev",
        "db:migrate:deploy": "NODE_ENV=production prisma migrate deploy",
        "db:reset": "prisma migrate reset",
        "prepare": "husky"
    },
    "license": "MIT",
    "packageManager": "bun@1.3.14",
    "engines": {
        "bun": ">=1.3.14"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.4.0",
        "@prisma/client": "^7.4.0",
        "bullmq": "^6.1.1",
        "chrono-node": "^2.10.1",
        "dotenv": "^16.6.1",
        "express": "^5.2.1",
        "ollama": "^0.6.3",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "prisma": "^7.4.0",
        "redis": "^5.10.0",
        "telegraf": "^4.16.3",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/node": "^25.2.3",
        "eslint": "^10.7.0",
        "husky": "^9.1.7",
        "prettier": "3.9.5",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.64.0"
    }
}
