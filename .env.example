# =============================================================================
# Talkasauras Bot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in all values.
# See docs/SETUP.md for detailed explanations of each variable.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Port the Express API server listens on (3000–5050 enforced at startup)
PORT=5000

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Connection string for the application (pooled in production)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB>?schema=public
# Development (local container): postgresql://postgres:password@localhost:5003/talkasauras_bot?schema=public
# Production: Cloud provider pooled URL
DATABASE_URL=postgresql://postgres:password@localhost:5003/talkasauras_bot?schema=public

# Direct (non-pooled) connection string for Prisma CLI migrations
# Development: Same as DATABASE_URL
# Production: Cloud provider direct/non-pooled URL
DIRECT_URL=postgresql://postgres:password@localhost:5003/talkasauras_bot?schema=public

# Local Postgres container credentials (development only; not used in production)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=talkasauras_bot

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Redis hostname
# Development: localhost (container publishes to host)
# Production: redis (internal Docker network service name)
REDIS_HOST=localhost

# Redis port
# Development: 5001 (host-published port)
# Production: 6379 (internal container port)
REDIS_PORT=5001

# Redis username (default for Redis 7+)
REDIS_USERNAME=default

# Redis password
# Development: password
# Production: Use a strong password
REDIS_PASSWORD=password

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
# Main (user-facing) bot token from @BotFather
TELEGRAM_BOT_TOKEN=<telegram_bot_token>

# Admin (internal) bot token from @BotFather (separate bot!)
TELEGRAM_BOT_TOKEN_INTERNAL=<admin_bot_token>

# -----------------------------------------------------------------------------
# Ollama (LLM)
# -----------------------------------------------------------------------------
# Base URL of the Ollama server (must be a valid URL with scheme)
# Options:
#   - Remote provider: https://ollama.com (or your provider's URL)
#   - Local container: http://localhost:5005 (compose maps 11434 → 5005)
#   - Mock server (dev only): http://localhost:5000/api/v1/mock
OLLAMA_HOST=http://localhost:5005

# API key sent as Bearer token with every Ollama request
# Local / mock: any non-empty string (e.g., local-dev-key)
# Remote: Key issued by your Ollama provider
OLLAMA_API_KEY=local-dev-key

# Model name for inference
# Remote: Provider's model name (e.g., minimax-m3)
# Local: Name of model pulled into Ollama container (see docs/SETUP.md §3.3)
OLLAMA_MODEL_NAME=<ollama_model_name>

# -----------------------------------------------------------------------------
# Security Keys (generate with: openssl rand -hex 32)
# -----------------------------------------------------------------------------
# HMAC key for hashing Telegram ID before database storage (min 32 chars)
SECRET_KEY_1=<64_hex_chars_hmac_key>

# AES-256-GCM key for encrypting Telegram ID & sensitive data (min 32 chars, different from SECRET_KEY_1)
SECRET_KEY_2=<64_hex_chars_aes_key>

# -----------------------------------------------------------------------------
# Admins
# -----------------------------------------------------------------------------
# Pipe-separated list of Telegram usernames or user IDs allowed to access admin bot
# Example: CypherBeing|another_admin_username
ADMINS=<username_or_userid>